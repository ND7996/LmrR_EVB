    "\n",
    "# ============================================================\n",
    "# Gibbs free-energy barrier from RRHO thermal/entropy corrections\n",
    "# ============================================================\n",
    "# This is a gas-phase ideal-gas RRHO estimate:\n",
    "#   G = E_electronic + H_corr(T) - T*S(T)\n",
    "#\n",
    "# It includes translational, rotational, and vibrational terms.\n",
    "# For TS thermochemistry, imaginary frequencies are excluded.\n",
    "# For floppy low-frequency modes, a small cutoff is used for entropy/thermal terms.\n",
    "\n",
    "THERMO_T = 298.15          # K\n",
    "THERMO_P = 101325.0       # Pa = 1 atm\n",
    "LOW_FREQ_CUTOFF_CM = 50.0 # set to 0.0 to disable quasi-harmonic low-frequency cutoff\n",
    "ROT_SYMMETRY_NUMBER = {\"RS\": 1, \"TS\": 1, \"PS\": 1}\n",
    "\n",
    "# Physical constants\n",
    "KB = 1.380649e-23            # J K^-1\n",
    "H_PLANCK = 6.62607015e-34    # J s\n",
    "C_LIGHT = 299792458.0        # m s^-1\n",
    "R_GAS = 8.31446261815324     # J mol^-1 K^-1\n",
    "AMU_TO_KG = 1.66053906660e-27\n",
    "ANGSTROM_TO_M = 1.0e-10\n",
    "HARTREE_TO_J_MOL = HARTREE_TO_KJMOL * 1000.0\n",
    "J_MOL_TO_HARTREE = 1.0 / HARTREE_TO_J_MOL\n",
    "\n",
    "ATOMIC_MASSES_AMU = {\n",
    "    \"H\": 1.00782503223,\n",
    "    \"C\": 12.00000000000,\n",
    "    \"N\": 14.00307400443,\n",
    "    \"O\": 15.99491461957,\n",
    "    \"F\": 18.99840316273,\n",
    "    \"P\": 30.97376199842,\n",
    "    \"S\": 31.97207117440,\n",
    "    \"Cl\": 34.968852682,\n",
    "    \"Br\": 78.9183376,\n",
    "    \"I\": 126.9044719,\n",
    "}\n",
    "\n",
    "\n",
    "def element_symbol(label):\n",
    "    \"\"\"Convert VeloxChem labels to element symbols.\"\"\"\n",
    "    letters = \"\".join(ch for ch in str(label) if ch.isalpha())\n",
    "    if not letters:\n",
    "        raise ValueError(f\"Could not infer element from label {label!r}\")\n",
    "\n",
    "    # Common organic elements in these QM clusters.\n",
    "    if letters.upper().startswith(\"CL\"):\n",
    "        return \"Cl\"\n",
    "    if letters.upper().startswith(\"BR\"):\n",
    "        return \"Br\"\n",
    "    first = letters[0].upper()\n",
    "    if first in {\"H\", \"C\", \"N\", \"O\", \"F\", \"P\", \"S\", \"I\"}:\n",
    "        return first\n",
    "    return first\n",
    "\n",
    "\n",
    "def molecule_masses_kg(molecule):\n",
    "    masses = []\n",
    "    for label in molecule.get_labels():\n",
    "        element = element_symbol(label)\n",
    "        if element not in ATOMIC_MASSES_AMU:\n",
    "            raise KeyError(f\"No atomic mass available for element {element!r} from label {label!r}\")\n",
    "        masses.append(ATOMIC_MASSES_AMU[element] * AMU_TO_KG)\n",
    "    return np.array(masses, dtype=float)\n",
    "\n",
    "\n",
    "def inertia_moments_kg_m2(molecule):\n",
    "    \"\"\"Principal moments of inertia in kg m^2.\"\"\"\n",
    "    coords_m = np.array(molecule.get_coordinates_in_angstrom(), dtype=float) * ANGSTROM_TO_M\n",
    "    masses_kg = molecule_masses_kg(molecule)\n",
    "\n",
    "    total_mass = np.sum(masses_kg)\n",
    "    center = np.sum(coords_m * masses_kg[:, None], axis=0) / total_mass\n",
    "    rel = coords_m - center\n",
    "\n",
    "    inertia = np.zeros((3, 3), dtype=float)\n",
    "    for mass, r in zip(masses_kg, rel):\n",
    "        r2 = float(np.dot(r, r))\n",
    "        inertia += mass * (r2 * np.eye(3) - np.outer(r, r))\n",
    "\n",
    "    moments = np.linalg.eigvalsh(inertia)\n",
    "    moments = np.sort(np.maximum(moments, 0.0))\n",
    "    return moments\n",
    "\n",
    "\n",
    "def rrho_thermochemistry(molecule, frequencies_cm, temperature=THERMO_T, pressure=THERMO_P, symmetry_number=1):\n",
    "    \"\"\"Return RRHO thermal corrections and entropy for one optimized structure.\n",
    "\n",
    "    Returns J/mol and Hartree correction terms.\n",
    "    \"\"\"\n",
    "    masses_kg = molecule_masses_kg(molecule)\n",
    "    total_mass_kg = float(np.sum(masses_kg))\n",
    "    moments = inertia_moments_kg_m2(molecule)\n",
    "\n",
    "    # Translational entropy and enthalpy, ideal gas, 1 atm standard state.\n",
    "    q_trans = ((2.0 * np.pi * total_mass_kg * KB * temperature) / (H_PLANCK ** 2)) ** 1.5\n",
    "    q_trans *= (KB * temperature / pressure)\n",
    "    s_trans = R_GAS * (np.log(q_trans) + 2.5)\n",
    "    h_trans = 2.5 * R_GAS * temperature\n",
    "\n",
    "    # Rotational entropy and enthalpy.\n",
    "    nonzero_moments = moments[moments > 1.0e-48]\n",
    "    if len(nonzero_moments) <= 1:\n",
    "        # Atom or near-atom fallback.\n",
    "        s_rot = 0.0\n",
    "        h_rot = 0.0\n",
    "        rotor_type = \"atom\"\n",
    "    elif len(nonzero_moments) == 2:\n",
    "        # Linear rotor.\n",
    "        rotor_type = \"linear\"\n",
    "        i_rot = float(np.max(nonzero_moments))\n",
    "        q_rot = (8.0 * np.pi ** 2 * i_rot * KB * temperature) / (symmetry_number * H_PLANCK ** 2)\n",
    "        s_rot = R_GAS * (np.log(q_rot) + 1.0)\n",
    "        h_rot = R_GAS * temperature\n",
    "    else:\n",
    "        # Nonlinear rotor.\n",
    "        rotor_type = \"nonlinear\"\n",
    "        ia, ib, ic = [float(x) for x in moments]\n",
    "        q_rot = (\n",
    "            np.sqrt(np.pi)\n",
    "            / symmetry_number\n",
    "            * ((8.0 * np.pi ** 2 * KB * temperature) / (H_PLANCK ** 2)) ** 1.5\n",
    "            * np.sqrt(ia * ib * ic)\n",
    "        )\n",
    "        s_rot = R_GAS * (np.log(q_rot) + 1.5)\n",
    "        h_rot = 1.5 * R_GAS * temperature\n",
    "\n",
    "    # Vibrational contribution. Exclude imaginary frequencies.\n",
    "    frequencies_cm = np.array(frequencies_cm, dtype=float)\n",
    "    positive_freqs = frequencies_cm[frequencies_cm > 0.0]\n",
    "    adjusted_freqs = np.maximum(positive_freqs, LOW_FREQ_CUTOFF_CM) if LOW_FREQ_CUTOFF_CM > 0 else positive_freqs\n",
    "\n",
    "    theta = (H_PLANCK * C_LIGHT * (adjusted_freqs * 100.0)) / KB\n",
    "    x = theta / temperature\n",
    "\n",
    "    # Numerically stable vibrational terms.\n",
    "    expm1_x = np.expm1(x)\n",
    "    vib_thermal_factor = 1.0 / expm1_x\n",
    "    h_vib = R_GAS * np.sum(theta * (0.5 + vib_thermal_factor))\n",
    "    s_vib = R_GAS * np.sum((x / expm1_x) - np.log1p(-np.exp(-x)))\n",
    "\n",
    "    s_total = float(s_trans + s_rot + s_vib)\n",
    "    h_corr = float(h_trans + h_rot + h_vib)\n",
    "    g_corr = float(h_corr - temperature * s_total)\n",
    "\n",
    "    return {\n",
    "        \"temperature_K\": temperature,\n",
    "        \"pressure_Pa\": pressure,\n",
    "        \"symmetry_number\": symmetry_number,\n",
    "        \"rotor_type\": rotor_type,\n",
    "        \"mass_kg_per_molecule\": total_mass_kg,\n",
    "        \"n_imaginary_excluded\": int(np.sum(frequencies_cm < 0.0)),\n",
    "        \"n_positive_frequencies\": int(len(positive_freqs)),\n",
    "        \"low_freq_cutoff_cm\": LOW_FREQ_CUTOFF_CM,\n",
    "        \"S_trans_J_mol_K\": float(s_trans),\n",
    "        \"S_rot_J_mol_K\": float(s_rot),\n",
    "        \"S_vib_J_mol_K\": float(s_vib),\n",
    "        \"S_total_J_mol_K\": s_total,\n",
    "        \"H_trans_J_mol\": float(h_trans),\n",
    "        \"H_rot_J_mol\": float(h_rot),\n",
    "        \"H_vib_J_mol\": float(h_vib),\n",
    "        \"H_corr_J_mol\": h_corr,\n",
    "        \"G_corr_J_mol\": g_corr,\n",
    "        \"H_corr_hartree\": h_corr * J_MOL_TO_HARTREE,\n",
    "        \"G_corr_hartree\": g_corr * J_MOL_TO_HARTREE,\n",
    "    }\n",
    "\n",
    "\n",
    "thermo_results = {}\n",
    "gibbs_rows = []\n",
    "\n",
    "for label in state_order:\n",
    "    frequencies = np.array(vib_results_all[label][\"vib_frequencies\"], dtype=float)\n",
    "    thermo = rrho_thermochemistry(\n",
    "        opt_molecules[label],\n",
    "        frequencies,\n",
    "        temperature=THERMO_T,\n",
    "        pressure=THERMO_P,\n",
    "        symmetry_number=ROT_SYMMETRY_NUMBER.get(label, 1),\n",
    "    )\n",
    "    thermo_results[label] = thermo\n",
    "\n",
    "electronic_ref = energies_hartree[\"RS\"]\n",
    "enthalpy_ref = energies_hartree[\"RS\"] + thermo_results[\"RS\"][\"H_corr_hartree\"]\n",
    "gibbs_ref = energies_hartree[\"RS\"] + thermo_results[\"RS\"][\"G_corr_hartree\"]\n",
    "\n",
    "for label in state_order:\n",
    "    e_h = energies_hartree[label]\n",
    "    h_h = e_h + thermo_results[label][\"H_corr_hartree\"]\n",
    "    g_h = e_h + thermo_results[label][\"G_corr_hartree\"]\n",
    "\n",
    "    gibbs_rows.append({\n",
    "        \"state\": label,\n",
    "        \"electronic_energy_hartree\": f\"{e_h:.12f}\",\n",
    "        \"H_corr_hartree\": f\"{thermo_results[label]['H_corr_hartree']:.12f}\",\n",
    "        \"G_corr_hartree\": f\"{thermo_results[label]['G_corr_hartree']:.12f}\",\n",
    "        \"enthalpy_hartree\": f\"{h_h:.12f}\",\n",
    "        \"gibbs_hartree\": f\"{g_h:.12f}\",\n",
    "        \"relative_electronic_kj_mol\": f\"{(e_h - electronic_ref) * HARTREE_TO_KJMOL:.6f}\",\n",
    "        \"relative_enthalpy_kj_mol\": f\"{(h_h - enthalpy_ref) * HARTREE_TO_KJMOL:.6f}\",\n",
    "        \"relative_gibbs_kj_mol\": f\"{(g_h - gibbs_ref) * HARTREE_TO_KJMOL:.6f}\",\n",
    "        \"S_total_J_mol_K\": f\"{thermo_results[label]['S_total_J_mol_K']:.6f}\",\n",
    "        \"S_trans_J_mol_K\": f\"{thermo_results[label]['S_trans_J_mol_K']:.6f}\",\n",
    "        \"S_rot_J_mol_K\": f\"{thermo_results[label]['S_rot_J_mol_K']:.6f}\",\n",
    "        \"S_vib_J_mol_K\": f\"{thermo_results[label]['S_vib_J_mol_K']:.6f}\",\n",
    "        \"n_imaginary_excluded\": thermo_results[label][\"n_imaginary_excluded\"],\n",
    "        \"n_positive_frequencies\": thermo_results[label][\"n_positive_frequencies\"],\n",
    "        \"low_freq_cutoff_cm\": LOW_FREQ_CUTOFF_CM,\n",
    "        \"temperature_K\": THERMO_T,\n",
    "        \"pressure_Pa\": THERMO_P,\n",
    "    })\n",
    "\n",
    "gibbs_csv = write_csv(\n",
    "    RESULTS_DIR / \"qm_gibbs_free_energy_barrier.csv\",\n",
    "    gibbs_rows,\n",
    "    [\n",
    "        \"state\",\n",
    "        \"electronic_energy_hartree\",\n",
    "        \"H_corr_hartree\",\n",
    "        \"G_corr_hartree\",\n",
    "        \"enthalpy_hartree\",\n",
    "        \"gibbs_hartree\",\n",
    "        \"relative_electronic_kj_mol\",\n",
    "        \"relative_enthalpy_kj_mol\",\n",
    "        \"relative_gibbs_kj_mol\",\n",
    "        \"S_total_J_mol_K\",\n",
    "        \"S_trans_J_mol_K\",\n",
    "        \"S_rot_J_mol_K\",\n",
    "        \"S_vib_J_mol_K\",\n",
    "        \"n_imaginary_excluded\",\n",
    "        \"n_positive_frequencies\",\n",
    "        \"low_freq_cutoff_cm\",\n",
    "        \"temperature_K\",\n",
    "        \"pressure_Pa\",\n",
    "    ],\n",
    ")\n",
