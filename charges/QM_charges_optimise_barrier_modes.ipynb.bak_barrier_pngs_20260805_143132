    "import re\n",
    "\n",
    "\n",
    "def resolve_input_file(path_like):\n",
    "    \"\"\"Resolve PDB files from BASE_DIR first, then the current working directory.\"\"\"\n",
    "    path = Path(path_like)\n",
    "    if path.is_absolute() and path.exists():\n",
    "        return path\n",
    "\n",
    "    for candidate in [BASE_DIR / path, Path.cwd() / path, path]:\n",
    "        if candidate.exists():\n",
    "            return candidate\n",
    "\n",
    "    raise FileNotFoundError(\n",
    "        f\"Could not find {path_like!r}. Checked BASE_DIR, current working directory, and literal path.\"\n",
    "    )\n",
    "\n",
    "\n",
    "def read_pdb_coordinates(pdb_path, chain=None, residue_name=None):\n",
    "    \"\"\"Parse a PDB file and return atom symbols + coordinates.\"\"\"\n",
    "    pdb_path = resolve_input_file(pdb_path)\n",
    "    atoms = []\n",
    "    coords = []\n",
    "\n",
    "    with open(pdb_path, \"r\") as f:\n",
    "        for line in f:\n",
    "            if line.startswith((\"ATOM\", \"HETATM\")):\n",
    "                rec_chain = line[21].strip()\n",
    "                rec_resname = line[17:20].strip()\n",
    "\n",
    "                if chain is not None and rec_chain != chain:\n",
    "                    continue\n",
    "                if residue_name is not None and rec_resname != residue_name:\n",
    "                    continue\n",
    "\n",
    "                x = float(line[30:38])\n",
    "                y = float(line[38:46])\n",
    "                z = float(line[46:54])\n",
    "\n",
    "                element = line[76:78].strip()\n",
    "                if not element:\n",
    "                    atom_name = line[12:16].strip()\n",
    "                    element = \"\".join([c for c in atom_name if c.isalpha()])[:2]\n",
    "                    element = element.capitalize()\n",
    "\n",
    "                # PDB formal-charge strings like \"N1+\" are not valid element symbols.\n",
    "                element = re.sub(r\"[^A-Za-z]\", \"\", element).capitalize()\n",
    "                if len(element) > 1 and element.upper().startswith(\"H\"):\n",
    "                    element = \"H\"\n",
    "\n",
    "                atoms.append(element)\n",
    "                coords.append((x, y, z))\n",
    "\n",
    "    return atoms, np.array(coords), pdb_path\n",
    "\n",
    "\n",
    "def read_formal_charge(pdb_path, default=0):\n",
    "    \"\"\"Pull 'REMARK  15 TOTAL FORMAL CHARGE +N' from the PDB header, if present.\"\"\"\n",
    "    pdb_path = resolve_input_file(pdb_path)\n",
    "    pattern = re.compile(r\"TOTAL FORMAL CHARGE\\s*([+-]?\\d+)\")\n",
    "    with open(pdb_path, \"r\") as f:\n",
    "        for line in f:\n",
    "            match = pattern.search(line)\n",
    "            if match:\n",
    "                return int(match.group(1))\n",
    "    return default\n",
    "\n",
    "\n",
    "def to_xyz_string(atoms, coords, comment=\"Structure from PDB\"):\n",
    "    lines = [str(len(atoms)), comment]\n",
    "    for atom, (x, y, z) in zip(atoms, coords):\n",
    "        lines.append(f\"{atom:2s} {x:12.6f} {y:12.6f} {z:12.6f}\")\n",
    "    return \"\\n\".join(lines)\n",
    "\n",
    "\n",
    "def write_text(path, text):\n",
    "    path = Path(path)\n",
    "    path.parent.mkdir(parents=True, exist_ok=True)\n",
    "    path.write_text(text, encoding=\"utf-8\")\n",
    "    return path\n",
    "\n",
    "\n",
    "def write_csv(path, rows, fieldnames):\n",
    "    path = Path(path)\n",
    "    path.parent.mkdir(parents=True, exist_ok=True)\n",
    "    with open(path, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n",
    "        writer = csv.DictWriter(f, fieldnames=fieldnames)\n",
    "        writer.writeheader()\n",
    "        writer.writerows(rows)\n",
    "    return path\n",
