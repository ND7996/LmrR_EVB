    "        print(f\"Optimized geometry ({label}):\")\n",
    "        print(optimized_xyz)\n",
    "        print(\"Optimization steps:\", optimization_steps[label])\n",
    "        print(f\"B3LYP-D/{basis_label} energy ({label}): {energy: .8f} Hartree\")\n",
    "\n",
    "    else:\n",
    "        raise ValueError(f\"Unknown run_mode: {run_mode!r}. Use 'quick' or 'full'.\")\n",
    "\n",
    "    print()\n",
