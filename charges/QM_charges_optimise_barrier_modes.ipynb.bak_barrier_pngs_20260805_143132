    "\n",
    "# ============================================================\n",
    "# run_mode = \"quick\" -> fast sanity check: single-point HF/def2-svp SCF\n",
    "#                        on the raw PDB geometry, no optimization, no\n",
    "#                        dispersion, no Hessian.\n",
    "# run_mode = \"full\"  -> real calculation: B3LYP-D geometry optimization\n",
    "#                        followed by a converged SCF at optimized geometry.\n",
    "# ============================================================\n",
    "run_mode = \"full\"\n",
    "\n",
    "basis_label = \"def2-svp\"\n",
    "xcfun_label = \"b3lyp\"\n",
    "use_dispersion = True\n",
    "\n",
    "opt_molecules = {}\n",
    "opt_results_all = {}\n",
    "scf_results_all = {}\n",
    "energies_hartree = {}\n",
    "optimization_steps = {}\n",
    "\n",
    "for label, mol in molecules.items():\n",
    "    print(f\"=== {run_mode.upper()} run: {label} (charge={charges[label]:+d}) ===\")\n",
    "\n",
    "    basis = vlx.MolecularBasis.read(mol, basis_label)\n",
    "    scf_drv = vlx.ScfRestrictedDriver()\n",
    "    scf_drv.ostream.mute()\n",
    "\n",
    "    if run_mode == \"quick\":\n",
    "        # Default driver settings = plain HF, no dispersion, no optimization.\n",
    "        scf_results = scf_drv.compute(mol, basis)\n",
    "        energy = float(scf_drv.get_scf_energy())\n",
    "\n",
    "        opt_molecules[label] = mol\n",
    "        scf_results_all[label] = scf_results\n",
    "        opt_results_all[label] = None\n",
    "        energies_hartree[label] = energy\n",
    "        optimization_steps[label] = 0\n",
    "\n",
    "        print(f\"HF/{basis_label} energy ({label}): {energy: .8f} Hartree\")\n",
    "\n",
    "    elif run_mode == \"full\":\n",
    "        scf_drv.xcfun = xcfun_label\n",
    "        scf_drv.dispersion = use_dispersion\n",
    "\n",
    "        opt_drv = vlx.OptimizationDriver(scf_drv)\n",
    "        opt_drv.ostream.mute()\n",
    "        opt_drv.max_iter = 100\n",
    "\n",
    "        # TS structures need a saddle-point search rather than a minimization.\n",
    "        if label == \"TS\" and hasattr(opt_drv, \"transition_state\"):\n",
    "            opt_drv.transition_state = True\n",
    "\n",
    "        opt_results = opt_drv.compute(mol, basis)\n",
    "        opt_molecule = opt_results[\"final_molecule\"]\n",
    "\n",
    "        # Converged SCF at the optimized geometry, needed for RESP fitting and final energies.\n",
    "        scf_results = scf_drv.compute(opt_molecule, basis)\n",
    "        energy = float(scf_drv.get_scf_energy())\n",
    "\n",
    "        opt_molecules[label] = opt_molecule\n",
    "        opt_results_all[label] = opt_results\n",
    "        scf_results_all[label] = scf_results\n",
    "        energies_hartree[label] = energy\n",
    "        optimization_steps[label] = len(opt_results.get(\"opt_energies\", []))\n",
    "\n",
    "        optimized_xyz = opt_molecule.get_xyz_string()\n",
    "        write_text(RESULTS_DIR / f\"{label}_optimized.xyz\", optimized_xyz)\n",
