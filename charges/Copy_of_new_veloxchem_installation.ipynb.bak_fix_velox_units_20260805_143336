      "RS1.2b_to_PS1.3: RS1.2b + H3O+ -> PS1.3 + H2O\n",
      "RS2.1_to_TS2.1a: RS2.1 -> TS2.1a\n",
      "TS2.1a_to_PS2.2: TS2.1a -> PS2.2\n"
     ]
