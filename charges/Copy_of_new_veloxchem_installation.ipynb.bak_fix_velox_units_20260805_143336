   "source": [
    "\n",
    "# Slide-state SMILES requested for the QM setup.\n",
    "# Labels such as TS1.2 and TS2.1a are connectivity/state labels here.\n",
    "# SMILES cannot encode a true partial-bond transition state.\n",
    "\n",
    "state_smiles = {\n",
    "    \"RS1.1\": \"CC(=O)NC(Cc1ccc(N)cc1)C(=O)NC.CCC/C=C/C=O\",\n",
    "    \"TS1.2\": \"CC(=O)NC(Cc1ccc([NH2+][CH]([O-])/C=C/CCC)cc1)C(=O)NC\",\n",
    "    \"PS1.2b\": \"CC(=O)NC(Cc1ccc(N[CH](O)/C=C/CCC)cc1)C(=O)NC\",\n",
    "    \"RS1.2b\": \"CC(=O)NC(Cc1ccc(N[CH](O)/C=C/CCC)cc1)C(=O)NC\",\n",
    "    \"PS1.3\": \"CC(=O)NC(Cc1ccc([NH+]=[CH]/C=C/CCC)cc1)C(=O)NC.O\",\n",
    "    \"RS2.1\": \"CC(=O)NC(Cc1ccc([NH+]=[CH]/C=C/CCC)cc1)C(=O)NC.c1ccc2[nH]ccc2c1\",\n",
    "    \"TS2.1a\": \"CC(=O)NC(Cc1ccc(N/C=C/C(CCC)C2C=[NH+]c3ccccc23)cc1)C(=O)NC\",\n",
    "    \"PS2.2\": \"CC(=O)NC(Cc1ccc([NH+]=[CH]CC(CCC)c2c[nH]c3ccccc23)cc1)C(=O)NC\",\n",
    "}\n",
    "\n",
    "# Small helper species used only to make VeloxChem transition inputs balanced.\n",
    "helper_smiles = {\n",
    "    \"H3O+\": \"[OH3+]\",\n",
    "    \"H2O\": \"O\",\n",
    "}\n",
    "\n",
    "# Transition inputs.\n",
    "# The third transition keeps your slide state PS1.3, but adds hydronium on the\n",
    "# reactant side and an extra water on the product side:\n",
    "#   RS1.2b + H3O+ -> PS1.3 + H2O\n",
    "# This is necessary because plain RS1.2b -> PS1.3 changes total charge 0 -> +1.\n",
    "slide_transitions = [\n",
    "    (\"RS1.1_to_TS1.2\", [\"RS1.1\"], [\"TS1.2\"]),\n",
    "    (\"TS1.2_to_PS1.2b\", [\"TS1.2\"], [\"PS1.2b\"]),\n",
    "    (\"RS1.2b_to_PS1.3\", [\"RS1.2b\", \"H3O+\"], [\"PS1.3\", \"H2O\"]),\n",
    "    (\"RS2.1_to_TS2.1a\", [\"RS2.1\"], [\"TS2.1a\"]),\n",
    "    (\"TS2.1a_to_PS2.2\", [\"TS2.1a\"], [\"PS2.2\"]),\n",
    "]\n",
    "\n",
    "\n",
    "def expand_items(items):\n",
    "    \"\"\"Expand state labels/helper labels/literal SMILES into individual SMILES parts.\"\"\"\n",
    "    parts = []\n",
    "    for item in items:\n",
    "        if item in state_smiles:\n",
    "            raw = state_smiles[item]\n",
    "        elif item in helper_smiles:\n",
    "            raw = helper_smiles[item]\n",
    "        else:\n",
    "            raw = item\n",
    "        parts.extend(part for part in raw.split(\".\") if part.strip())\n",
    "    return parts\n",
    "\n",
    "\n",
    "def mols_from_items(items):\n",
    "    \"\"\"Convert transition item labels into VeloxChem molecule objects.\"\"\"\n",
    "    return [vlx.Molecule.read_smiles(smi) for smi in expand_items(items)]\n",
    "\n",
    "\n",
    "def pretty_items(items):\n",
    "    return \" + \".join(items)\n",
    "\n",
    "\n",
    "print(\"Slide states loaded:\")\n",
    "for label, smiles in state_smiles.items():\n",
    "    print(f\"{label}: {smiles}\")\n",
    "\n",
    "print(\"\\nTransitions to run:\")\n",
    "for label, reactant_items, product_items in slide_transitions:\n",
    "    print(f\"{label}: {pretty_items(reactant_items)} -> {pretty_items(product_items)}\")\n"
   ]
