   "source": [
    "\n",
    "# Sanity check before running the expensive TS guesses.\n",
    "# Every transition should have matching atom counts and total charge.\n",
    "\n",
    "def total_counts_and_charge(items):\n",
    "    total_counts = {}\n",
    "    total_charge = 0\n",
    "    total_atoms = 0\n",
    "\n",
    "    for smi in expand_items(items):\n",
    "        mol = Chem.MolFromSmiles(smi)\n",
    "        if mol is None:\n",
    "            return None, None, None\n",
    "        mol_h = Chem.AddHs(mol)\n",
    "        total_atoms += mol_h.GetNumAtoms()\n",
    "        for atom in mol_h.GetAtoms():\n",
    "            total_counts[atom.GetSymbol()] = total_counts.get(atom.GetSymbol(), 0) + 1\n",
    "            total_charge += atom.GetFormalCharge()\n",
    "    return total_counts, total_charge, total_atoms\n",
    "\n",
    "\n",
    "print(\"Atom-balance check:\")\n",
    "for transition_label, reactant_items, product_items in slide_transitions:\n",
    "    rc, rq, ra = total_counts_and_charge(reactant_items)\n",
    "    pc, pq, pa = total_counts_and_charge(product_items)\n",
    "    balanced = (rc == pc and rq == pq and ra == pa)\n",
    "    print(f\"{transition_label}: balanced={balanced} | atoms {ra}->{pa} | charge {rq}->{pq}\")\n",
    "    if not balanced:\n",
    "        print(\"  Reactants:\", pretty_items(reactant_items))\n",
    "        print(\"  Products: \", pretty_items(product_items))\n",
    "        print(\"  Reactant counts:\", rc)\n",
    "        print(\"  Product counts: \", pc)\n"
   ]
