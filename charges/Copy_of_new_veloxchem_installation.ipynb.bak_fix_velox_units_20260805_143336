    "\n",
    "# Real QM relaxed distance scans for every slide transition through the last step.\n",
    "# This uses the best TS guess geometry from all_ts_results[label], then performs\n",
    "# repeated constrained QM optimizations with \"set distance i j target\".\n",
    "#\n",
    "# Workflow:\n",
    "#   1. Run the transition-state finder cell above.\n",
    "#   2. Run this cell.\n",
    "#   3. Check the proposed qm_scan_jobs table.\n",
    "#   4. Run:\n",
    "#        run_all_qm_relaxed_scans()\n",
    "#\n",
    "# Important: these scans are still 1D scans. A real TS must still be optimized\n",
    "# and confirmed by one imaginary frequency + IRC.\n",
    "\n",
    "HARTREE_TO_KJMOL = 2625.499638\n",
    "\n",
    "\n",
    "def transition_total_charge(transition_label):\n",
    "    \"\"\"Return the total charge for a transition from the reactant side.\"\"\"\n",
    "    for label, reactant_items, product_items in slide_transitions:\n",
    "        if label == transition_label:\n",
    "            _, charge, _ = total_counts_and_charge(reactant_items)\n",
    "            return int(round(charge))\n",
    "    return 0\n",
    "\n",
    "\n",
    "def best_xyz_for_transition(transition_label):\n",
    "    \"\"\"Prefer QM-rescored geometry; fall back to MM geometry.\"\"\"\n",
    "    result = all_ts_results[transition_label]\n",
    "    if \"max_qm_xyz\" in result:\n",
    "        return result[\"max_qm_xyz\"], \"max_qm_xyz\"\n",
    "    if \"max_mm_xyz\" in result:\n",
    "        return result[\"max_mm_xyz\"], \"max_mm_xyz\"\n",
    "    raise KeyError(f\"No max_qm_xyz or max_mm_xyz found for {transition_label}. Keys: {list(result.keys())}\")\n",
    "\n",
    "\n",
    "def xyz_atom_table(xyz):\n",
    "    \"\"\"Return [(index, element, x, y, z), ...] from an XYZ string.\"\"\"\n",
    "    rows = []\n",
    "    for i, line in enumerate(xyz.splitlines()[2:], start=1):\n",
    "        parts = line.split()\n",
    "        if len(parts) < 4:\n",
    "            continue\n",
    "        rows.append((i, parts[0], float(parts[1]), float(parts[2]), float(parts[3])))\n",
    "    return rows\n",
    "\n",
    "\n",
    "def xyz_distance(xyz, atom_i, atom_j):\n",
    "    rows = {idx: np.array([x, y, z], dtype=float) for idx, element, x, y, z in xyz_atom_table(xyz)}\n",
    "    return float(np.linalg.norm(rows[atom_i] - rows[atom_j]))\n",
    "\n",
    "\n",
    "def atom_element_from_xyz(xyz, atom_index):\n",
    "    for idx, element, x, y, z in xyz_atom_table(xyz):\n",
    "        if idx == atom_index:\n",
    "            return element\n",
    "    return \"?\"\n",
    "\n",
    "\n",
    "def show_ts_guess_with_indices(transition_label, every_atom=True):\n",
    "    \"\"\"Show the chosen TS guess and print VeloxChem atom indices.\"\"\"\n",
    "    xyz, xyz_key = best_xyz_for_transition(transition_label)\n",
    "    charge = transition_total_charge(transition_label)\n",
    "    mol = vlx.Molecule.read_xyz_string(xyz)\n",
    "    mol.set_charge(charge)\n",
    "    mol.set_multiplicity(1)\n",
    "\n",
    "    print(f\"{transition_label}: showing {xyz_key}, charge={charge}, multiplicity=1\")\n",
    "    print(\"Atom indices from the XYZ used by VeloxChem:\")\n",
    "    for idx, element, x, y, z in xyz_atom_table(xyz):\n",
    "        if every_atom:\n",
    "            print(f\"{idx:4d} {element:2s}  {x:10.4f} {y:10.4f} {z:10.4f}\")\n",
    "\n",
    "    if ENABLE_3DMOL_VIEWERS:\n",
    "        try:\n",
    "            mol.show(atom_indices=True, atom_labels=True)\n",
    "        except Exception as exc:\n",
    "            print(f\"mol.show failed, but atom table above is still usable: {type(exc).__name__}: {exc}\")\n",
    "    else:\n",
    "        print(\"3D viewer skipped because ENABLE_3DMOL_VIEWERS=False. Use the printed atom table and exported XYZ files.\")\n",
    "\n",
    "    return mol\n",
    "\n",
    "\n",
    "def make_scf_driver(xcfun=\"b3lyp\", dispersion=True, print_level=1):\n",
    "    scf_drv = vlx.ScfRestrictedDriver()\n",
    "    scf_drv.xcfun = xcfun\n",
    "    try:\n",
    "        scf_drv.dispersion = dispersion\n",
    "    except Exception:\n",
    "        pass\n",
    "    try:\n",
    "        scf_drv.print_level = print_level\n",
    "    except Exception:\n",
    "        pass\n",
    "    return scf_drv\n",
    "\n",
    "\n",
    "def final_single_point_energy(mol, basis_name=\"def2-svp\", xcfun=\"b3lyp\", dispersion=True):\n",
    "    \"\"\"Compute a clean final single-point energy for the optimized constrained geometry.\"\"\"\n",
    "    basis = vlx.MolecularBasis.read(mol, basis_name)\n",
    "    scf_drv = make_scf_driver(xcfun=xcfun, dispersion=dispersion, print_level=1)\n",
    "    scf_drv.compute(mol, basis)\n",
    "    return float(scf_drv.get_scf_energy())\n",
    "\n",
    "\n",
    "def choose_scan_pair_from_bond_changes(transition_label):\n",
    "    \"\"\"Choose one good 1D scan coordinate from VeloxChem's reaction summary.\n",
    "\n",
    "    Priority:\n",
    "      - C-C / heavy-heavy forming bond for addition steps.\n",
    "      - O-H / N-H forming bond for proton transfer.\n",
    "      - C-O / heavy-heavy breaking bond for dehydration.\n",
    "    \"\"\"\n",
    "    xyz, _ = best_xyz_for_transition(transition_label)\n",
    "    changes = all_ts_bond_changes.get(transition_label, {\"forming\": [], \"breaking\": []})\n",
    "\n",
    "    def classify(pair, section):\n",
    "        i, j = pair\n",
    "        ei = atom_element_from_xyz(xyz, i)\n",
    "        ej = atom_element_from_xyz(xyz, j)\n",
    "        has_h = (ei.upper() == \"H\" or ej.upper() == \"H\")\n",
    "        heavy_heavy = not has_h\n",
    "        d0 = xyz_distance(xyz, i, j)\n",
    "        return {\n",
    "            \"atom_i\": i,\n",
    "            \"atom_j\": j,\n",
    "            \"elements\": (ei, ej),\n",
    "            \"section\": section,\n",
    "            \"has_h\": has_h,\n",
    "            \"heavy_heavy\": heavy_heavy,\n",
    "            \"current_distance\": d0,\n",
    "        }\n",
    "\n",
    "    candidates = []\n",
    "    for section in (\"forming\", \"breaking\"):\n",
    "        for pair in changes.get(section, []):\n",
    "            candidates.append(classify(pair, section))\n",
    "\n",
    "    if not candidates:\n",
    "        return None\n",
    "\n",
    "    # Step-specific preference where the chemistry is clear.\n",
    "    if transition_label == \"RS1.2b_to_PS1.3\":\n",
    "        # Dehydration: scan C-O breaking rather than just an O-H proton move.\n",
    "        for cand in candidates:\n",
    "            if cand[\"section\"] == \"breaking\" and cand[\"heavy_heavy\"]:\n",
    "                return cand\n",
    "\n",
    "    # General preferences.\n",
    "    for cand in candidates:\n",
    "        if cand[\"section\"] == \"forming\" and cand[\"heavy_heavy\"]:\n",
    "            return cand\n",
    "    for cand in candidates:\n",
    "        if cand[\"section\"] == \"forming\" and cand[\"has_h\"]:\n",
    "            return cand\n",
    "    for cand in candidates:\n",
    "        if cand[\"section\"] == \"breaking\" and cand[\"heavy_heavy\"]:\n",
    "            return cand\n",
    "    return candidates[0]\n",
    "\n",
    "\n",
    "def default_distances_for_coordinate(job, n_points=9):\n",
    "    \"\"\"Generate a sensible distance range for the selected coordinate.\"\"\"\n",
    "    ei, ej = [e.upper() for e in job[\"elements\"]]\n",
    "    has_h = job[\"has_h\"]\n",
    "    section = job[\"section\"]\n",
    "    d0 = job[\"current_distance\"]\n",
    "\n",
    "    if has_h:\n",
    "        if section == \"forming\":\n",
    "            return np.linspace(max(1.65, d0 + 0.25), 0.98, n_points)\n",
    "        return np.linspace(min(1.05, d0), 1.80, n_points)\n",
    "\n",
    "    # Heavy-heavy distances.\n",
    "    if section == \"forming\":\n",
    "        # C-C / C-N formation: long -> bonded.\n",
    "        bonded = 1.45 if \"N\" in (ei, ej) else 1.55\n",
    "        return np.linspace(max(2.8, d0 + 0.45), bonded, n_points)\n",
    "\n",
    "    # Heavy-heavy breaking, e.g. C-O dehydration: bonded -> separated.\n",
    "    return np.linspace(min(1.45, d0), max(2.8, d0 + 0.55), n_points)\n",
    "\n",
    "\n",
    "def build_qm_scan_jobs():\n",
    "    \"\"\"Build scan jobs for all successful transitions through the final step.\"\"\"\n",
    "    jobs = {}\n",
    "\n",
    "    for transition_label in all_ts_results:\n",
    "        selected = choose_scan_pair_from_bond_changes(transition_label)\n",
    "        if selected is None:\n",
    "            print(f\"WARNING: no parsed bond changes for {transition_label}; inspect manually with show_ts_guess_with_indices().\")\n",
    "            continue\n",
    "\n",
    "        selected[\"distances\"] = default_distances_for_coordinate(selected, n_points=9)\n",
    "        jobs[transition_label] = selected\n",
    "\n",
    "    # Manual correction from your pasted VeloxChem output:\n",
    "    # 1.1 forming bond: 11-40\n",
    "    if \"RS1.1_to_TS1.2\" in all_ts_results:\n",
    "        xyz, _ = best_xyz_for_transition(\"RS1.1_to_TS1.2\")\n",
    "        jobs[\"RS1.1_to_TS1.2\"] = {\n",
    "            \"atom_i\": 11,\n",
    "            \"atom_j\": 40,\n",
    "            \"elements\": (atom_element_from_xyz(xyz, 11), atom_element_from_xyz(xyz, 40)),\n",
    "            \"section\": \"forming\",\n",
    "            \"has_h\": False,\n",
    "            \"heavy_heavy\": True,\n",
    "            \"current_distance\": xyz_distance(xyz, 11, 40),\n",
    "            \"distances\": np.linspace(2.6, 1.45, 9),\n",
    "        }\n",
    "\n",
    "    # 1.2 proton transfer from pasted VeloxChem output:\n",
    "    # forming O-H: 13-35; breaking N-H: 11-35.\n",
    "    if \"TS1.2_to_PS1.2b\" in all_ts_results:\n",
    "        xyz, _ = best_xyz_for_transition(\"TS1.2_to_PS1.2b\")\n",
    "        jobs[\"TS1.2_to_PS1.2b\"] = {\n",
    "            \"atom_i\": 13,\n",
    "            \"atom_j\": 35,\n",
    "            \"elements\": (atom_element_from_xyz(xyz, 13), atom_element_from_xyz(xyz, 35)),\n",
    "            \"section\": \"forming\",\n",
    "            \"has_h\": True,\n",
    "            \"heavy_heavy\": False,\n",
    "            \"current_distance\": xyz_distance(xyz, 13, 35),\n",
    "            \"distances\": np.linspace(1.75, 0.98, 9),\n",
    "        }\n",
    "\n",
    "    return jobs\n",
    "\n",
    "\n",
    "def print_qm_scan_jobs(jobs=None):\n",
    "    if jobs is None:\n",
    "        jobs = qm_scan_jobs\n",
    "    headers = [\"transition\", \"section\", \"atoms\", \"elements\", \"current Å\", \"scan Å\"]\n",
    "    html = \"<table><tr>\" + \"\".join(f\"<th>{h}</th>\" for h in headers) + \"</tr>\"\n",
    "    for label, job in jobs.items():\n",
    "        scan_txt = f\"{float(job['distances'][0]):.2f} -> {float(job['distances'][-1]):.2f} ({len(job['distances'])} pts)\"\n",
    "        html += (\n",
    "            \"<tr>\"\n",
    "            f\"<td>{label}</td>\"\n",
    "            f\"<td>{job['section']}</td>\"\n",
    "            f\"<td>{job['atom_i']}-{job['atom_j']}</td>\"\n",
    "            f\"<td>{job['elements'][0]}-{job['elements'][1]}</td>\"\n",
    "            f\"<td>{job['current_distance']:.3f}</td>\"\n",
    "            f\"<td>{scan_txt}</td>\"\n",
    "            \"</tr>\"\n",
    "        )\n",
    "    html += \"</table>\"\n",
    "    display(HTML(html))\n",
    "\n",
    "\n",
    "def run_qm_relaxed_distance_scan(\n",
    "    transition_label,\n",
    "    atom_i,\n",
    "    atom_j,\n",
    "    distances,\n",
    "    basis_name=\"def2-svp\",\n",
    "    xcfun=\"b3lyp\",\n",
    "    dispersion=True,\n",
    "    max_iter=80,\n",
    "):\n",
    "    \"\"\"Run a true relaxed QM scan along one distance.\n",
    "\n",
    "    atom_i and atom_j are 1-based VeloxChem atom indices.\n",
    "    \"\"\"\n",
    "    xyz, xyz_key = best_xyz_for_transition(transition_label)\n",
    "    charge = transition_total_charge(transition_label)\n",
    "\n",
    "    mol = vlx.Molecule.read_xyz_string(xyz)\n",
    "    mol.set_charge(charge)\n",
    "    mol.set_multiplicity(1)\n",
    "\n",
    "    scan_rows = []\n",
    "    scan_geometries = {}\n",
    "\n",
    "    print(f\"Starting relaxed QM scan for {transition_label}\")\n",
    "    print(f\"Initial geometry: {xyz_key}; charge={charge}; atoms={atom_i}-{atom_j}\")\n",
    "    print(f\"Method: {xcfun}/{basis_name}; dispersion={dispersion}\")\n",
