    "\n",
    "# Run all slide transitions and store every result.\n",
    "# This replaces the old ts_dict-only logic.\n",
    "\n",
    "# This asks the VeloxChem TS guesser to do the additional QM/SCF scan\n",
    "# after the MM scan. It is slower, but the energy curve is more meaningful\n",
    "# than the rough MM curve. Different VeloxChem versions use either\n",
    "# scf_scan or do_qm_scan, so the code sets both when available.\n",
    "RUN_VELOXCHEM_QM_SCAN = True\n",
    "\n",
    "import io\n",
    "import re\n",
    "import contextlib\n",
    "\n",
    "\n",
    "def parse_reaction_summary(text):\n",
    "    \"\"\"Parse VeloxChem's printed reaction-summary bond changes.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    dict\n",
    "        {\"breaking\": [(i, j), ...], \"forming\": [(i, j), ...]}\n",
    "    \"\"\"\n",
    "    changes = {\"breaking\": [], \"forming\": []}\n",
    "    section = None\n",
    "\n",
    "    for line in text.splitlines():\n",
    "        low = line.lower()\n",
    "        if \"breaking bonds\" in low:\n",
    "            section = \"breaking\"\n",
    "            continue\n",
    "        if \"forming bonds\" in low:\n",
    "            section = \"forming\"\n",
    "            continue\n",
    "        if \"system has charge\" in low or \"starting mm scan\" in low:\n",
    "            section = None\n",
    "\n",
    "        if section is None:\n",
    "            continue\n",
    "\n",
    "        # Example line:\n",
    "        #   nv       ny    11 -     c       c3    40\n",
    "        m = re.search(r\"\\s+\\S+\\s+\\S+\\s+(\\d+)\\s+-\\s+\\S+\\s+\\S+\\s+(\\d+)\\s*$\", line)\n",
    "        if m:\n",
    "            changes[section].append((int(m.group(1)), int(m.group(2))))\n",
    "\n",
    "    return changes\n",
    "\n",
    "\n",
    "all_ts_results = {}\n",
    "all_ts_guessers = {}\n",
    "all_ts_bond_changes = {}\n",
    "all_ts_stdout = {}\n",
    "failed_ts_results = {}\n",
    "\n",
    "for transition_label, reactant_items, product_items in slide_transitions:\n",
    "    print(f\"\\n================ {transition_label} ================\")\n",
    "    print(f\"{pretty_items(reactant_items)}  ->  {pretty_items(product_items)}\")\n",
    "\n",
    "    try:\n",
    "        ts_guess = vlx.TransitionStateGuesser()\n",
    "\n",
    "        if RUN_VELOXCHEM_QM_SCAN:\n",
    "            # Official examples use scf_scan=True. Some versions also accept do_qm_scan=True.\n",
    "            for attr in (\"scf_scan\", \"do_qm_scan\"):\n",
    "                try:\n",
    "                    setattr(ts_guess, attr, True)\n",
    "                except Exception:\n",
    "                    pass\n",
    "\n",
    "        reactants = mols_from_items(reactant_items)\n",
    "        products = mols_from_items(product_items)\n",
    "\n",
    "        # Capture output so we can automatically extract forming/breaking atom pairs.\n",
    "        # Then print it back so the notebook still shows the normal VeloxChem log.\n",
    "        buffer = io.StringIO()\n",
    "        with contextlib.redirect_stdout(buffer):\n",
    "            result = ts_guess.find_transition_state(reactants, products)\n",
    "        log_text = buffer.getvalue()\n",
    "        print(log_text)\n",
    "\n",
    "        all_ts_results[transition_label] = result\n",
    "        all_ts_guessers[transition_label] = ts_guess\n",
    "        all_ts_stdout[transition_label] = log_text\n",
    "        all_ts_bond_changes[transition_label] = parse_reaction_summary(log_text)\n",
    "        globals()[\"ts_\" + transition_label.replace(\".\", \"_\")] = result\n",
    "\n",
    "        print(f\"Stored result as all_ts_results['{transition_label}']\")\n",
    "        print(f\"Bond changes: {all_ts_bond_changes[transition_label]}\")\n",
    "    except Exception as exc:\n",
    "        failed_ts_results[transition_label] = exc\n",
    "        print(f\"FAILED {transition_label}: {type(exc).__name__}: {exc}\")\n",
    "\n",
    "print(\"\\nFinished.\")\n",
    "print(\"Successful transitions:\", list(all_ts_results.keys()))\n",
    "print(\"Failed transitions:\", {k: str(v) for k, v in failed_ts_results.items()})\n"
   ]
