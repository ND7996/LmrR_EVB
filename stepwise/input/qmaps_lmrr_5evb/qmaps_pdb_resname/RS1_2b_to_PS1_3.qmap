# RS1_2b_to_PS1_3
# RS1.2b (step_1_3_RS.pdb)  ->  PS1.3 (step_1_3_PS.pdb)
# Carbinolamine dehydration to iminium; W1 hydronium protonates the OH leaving group and the C-N bond becomes iminium-like.
#
# q atom (q)         PDB ID          LIB ID (resname.name)
# or neighbour (n)?  (resid.atom)    RS1.2b         PS1.3         
#
# PDB-RESNAME MODE: STATE columns keep the PDB residue names.
# If you use separate EVB libraries for each valence state, use qmaps_state_alias instead.
#
q                   1.N2            PAF.N2           PAF.N2           # serial 1 PAF A1.N2
q                   1.C9            PAF.C9           PAF.C9           # serial 2 PAF A1.C9
q                   1.C7            PAF.C7           PAF.C7           # serial 3 PAF A1.C7
q                   1.C4            PAF.C4           PAF.C4           # serial 4 PAF A1.C4
q                   1.C3            PAF.C3           PAF.C3           # serial 5 PAF A1.C3
q                   1.C5            PAF.C5           PAF.C5           # serial 6 PAF A1.C5
q                   1.C8            PAF.C8           PAF.C8           # serial 7 PAF A1.C8
q                   1.C1            PAF.C1           PAF.C1           # serial 8 PAF A1.C1
q                   1.C2            PAF.C2           PAF.C2           # serial 9 PAF A1.C2
q                   2.C10           ENL.C10          ENL.C10          # serial 10 ENL B2.C10
q                   2.C11           ENL.C11          ENL.C11          # serial 11 ENL B2.C11
q                   2.C12           ENL.C12          ENL.C12          # serial 12 ENL B2.C12
q                   2.C13           ENL.C13          ENL.C13          # serial 13 ENL B2.C13
q                   2.C14           ENL.C14          ENL.C14          # serial 14 ENL B2.C14
q                   2.C15           ENL.C15          ENL.C15          # serial 15 ENL B2.C15
q                   2.O1            ENL.O1           ENL.O1           # serial 16 ENL B2.O1
q                   4.O3            WAT.O3           WAT.O3           # serial 27 WAT W4.O3
q                   1.H4            PAF.H4           PAF.H4           # serial 28 PAF A1.H4
q                   1.H22           PAF.H22          PAF.H22          # serial 29 PAF A1.H22
q                   1.H11           PAF.H11          PAF.H11          # serial 30 PAF A1.H11
q                   1.H9            PAF.H9           PAF.H9           # serial 31 PAF A1.H9
q                   1.H10           PAF.H10          PAF.H10          # serial 32 PAF A1.H10
q                   1.H12           PAF.H12          PAF.H12          # serial 33 PAF A1.H12
q                   1.H6            PAF.H6           PAF.H6           # serial 34 PAF A1.H6
q                   1.H7            PAF.H7           PAF.H7           # serial 35 PAF A1.H7
q                   1.H8            PAF.H8           PAF.H8           # serial 36 PAF A1.H8
q                   1.H2            PAF.H2           PAF.H2           # serial 37 PAF A1.H2
q                   2.H             NME.H            NME.H            # serial 38 NME A2.H
q                   2.H12           ENL.H12          ENL.H12          # serial 39 ENL B2.H12
q                   2.H13           ENL.H13          ENL.H13          # serial 40 ENL B2.H13
q                   2.H14           ENL.H14          ENL.H14          # serial 41 ENL B2.H14
q                   2.H15           ENL.H15          ENL.H15          # serial 42 ENL B2.H15
q                   2.H16           ENL.H16          ENL.H16          # serial 43 ENL B2.H16
q                   2.H17           ENL.H17          ENL.H17          # serial 44 ENL B2.H17
q                   2.H18           ENL.H18          ENL.H18          # serial 45 ENL B2.H18
q                   2.H19           ENL.H19          ENL.H19          # serial 46 ENL B2.H19
q                   2.H20           ENL.H20          ENL.H20          # serial 47 ENL B2.H20
q                   2.H21           ENL.H21          ENL.H21          # serial 48 ENL B2.H21
q                   4.H22           WAT.H22          WAT.H22          # serial 58 WAT W4.H22
q                   4.H23           WAT.H23          WAT.H23          # serial 59 WAT W4.H23
q                   5.O3            WA2.O3           WA2.O3           # serial 60 WA2 X5.O3
q                   5.H22           WA2.H22          WA2.H22          # serial 61 WA2 X5.H22
q                   5.H23           WA2.H23          WA2.H23          # serial 62 WA2 X5.H23
q                   1.N1            PAF.N1           PAF.N1           # serial 63 PAF A1.N1
q                   1.C6            PAF.C6           PAF.C6           # serial 64 PAF A1.C6
q                   1.O2            PAF.O2           PAF.O2           # serial 65 PAF A1.O2
q                   0.CH3           ACE.CH3          ACE.CH3          # serial 66 ACE A0.CH3
q                   0.C             ACE.C            ACE.C            # serial 67 ACE A0.C
q                   0.O             ACE.O            ACE.O            # serial 68 ACE A0.O
q                   0.HH31          ACE.HH31         ACE.HH31         # serial 69 ACE A0.HH31
q                   0.HH32          ACE.HH32         ACE.HH32         # serial 70 ACE A0.HH32
q                   0.HH33          ACE.HH33         ACE.HH33         # serial 71 ACE A0.HH33
q                   2.N             NME.N            NME.N            # serial 72 NME A2.N
q                   2.CH3           NME.CH3          NME.CH3          # serial 73 NME A2.CH3
q                   2.HH31          NME.HH31         NME.HH31         # serial 74 NME A2.HH31
q                   2.HH32          NME.HH32         NME.HH32         # serial 75 NME A2.HH32
q                   2.HH33          NME.HH33         NME.HH33         # serial 76 NME A2.HH33

# Bond changes:
# broken: 27-29 (WAT.O3 -- PAF.H22); W1 hydronium O-H bond breaks
# formed: 16-29 (ENL.O1 -- PAF.H22); carbinolamine O accepts H29, making leaving water
# broken: 10-16 (ENL.C10 -- ENL.O1); C-O bond to leaving water breaks
# double-bond formed: 1-10 (PAF.N2 -- ENL.C10); pAF N/enal C iminium double bond forms
