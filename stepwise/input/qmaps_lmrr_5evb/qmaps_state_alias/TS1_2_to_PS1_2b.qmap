q                   2.H19           T12E.H19         P12E.H19         # serial 46 ENL B2.H19
q                   2.H20           T12E.H20         P12E.H20         # serial 47 ENL B2.H20
q                   2.H21           T12E.H21         P12E.H21         # serial 48 ENL B2.H21
q                   4.H22           T12W.H22         P12W.H22         # serial 58 WAT W4.H22
q                   4.H23           T12W.H23         P12W.H23         # serial 59 WAT W4.H23
q                   5.O3            T122.O3          P122.O3          # serial 60 WA2 X5.O3
