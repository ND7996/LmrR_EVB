q                   1.C5            T12P.C5          P12P.C5          # serial 6 PAF A1.C5
q                   1.C8            T12P.C8          P12P.C8          # serial 7 PAF A1.C8
q                   1.C1            T12P.C1          P12P.C1          # serial 8 PAF A1.C1
q                   1.C2            T12P.C2          P12P.C2          # serial 9 PAF A1.C2
q                   2.C10           T12E.C10         P12E.C10         # serial 10 ENL B2.C10
q                   2.C11           T12E.C11         P12E.C11         # serial 11 ENL B2.C11
q                   2.C12           T12E.C12         P12E.C12         # serial 12 ENL B2.C12
q                   2.C13           T12E.C13         P12E.C13         # serial 13 ENL B2.C13
q                   2.C14           T12E.C14         P12E.C14         # serial 14 ENL B2.C14
q                   2.C15           T12E.C15         P12E.C15         # serial 15 ENL B2.C15
q                   2.O1            T12E.O1          P12E.O1          # serial 16 ENL B2.O1
q                   4.O3            T12W.O3          P12W.O3          # serial 27 WAT W4.O3
q                   1.H4            T12P.H4          P12P.H4          # serial 28 PAF A1.H4
q                   1.H22           T12P.H22         P12P.H22         # serial 29 PAF A1.H22
q                   1.H11           T12P.H11         P12P.H11         # serial 30 PAF A1.H11
q                   1.H9            T12P.H9          P12P.H9          # serial 31 PAF A1.H9
q                   1.H10           T12P.H10         P12P.H10         # serial 32 PAF A1.H10
q                   1.H12           T12P.H12         P12P.H12         # serial 33 PAF A1.H12
q                   1.H6            T12P.H6          P12P.H6          # serial 34 PAF A1.H6
q                   1.H7            T12P.H7          P12P.H7          # serial 35 PAF A1.H7
q                   1.H8            T12P.H8          P12P.H8          # serial 36 PAF A1.H8
q                   1.H2            T12P.H2          P12P.H2          # serial 37 PAF A1.H2
q                   2.H             T12N.H           P12N.H           # serial 38 NME A2.H
q                   2.H12           T12E.H12         P12E.H12         # serial 39 ENL B2.H12
q                   2.H13           T12E.H13         P12E.H13         # serial 40 ENL B2.H13
q                   2.H14           T12E.H14         P12E.H14         # serial 41 ENL B2.H14
q                   2.H15           T12E.H15         P12E.H15         # serial 42 ENL B2.H15
q                   2.H16           T12E.H16         P12E.H16         # serial 43 ENL B2.H16
