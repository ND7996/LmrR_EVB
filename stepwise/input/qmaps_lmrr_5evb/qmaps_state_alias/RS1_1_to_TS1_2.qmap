# RS1_1_to_TS1_2
# RS1.1 (step_1_1_RS.pdb)  ->  TS1.2 (step_1_1_PS.pdb)
# Nucleophilic addition of the pAF amine to the enal carbonyl carbon; this gives the tetrahedral ammonium/alkoxide state used as TS1.2.
#
# q atom (q)         PDB ID          LIB ID (resname.name)
# or neighbour (n)?  (resid.atom)    RS1.1          TS1.2         
#
# STATE-ALIAS MODE: make sure your .lib residue names match these aliases.
# Component aliases:
#   ACE: R11A -> T12A
#   ENL: R11E -> T12E
#   NME: R11N -> T12N
#   PAF: R11P -> T12P
#   WA2: R112 -> T122
#   WAT: R11W -> T12W
#
q                   1.N2            R11P.N2          T12P.N2          # serial 1 PAF A1.N2
q                   1.C9            R11P.C9          T12P.C9          # serial 2 PAF A1.C9
q                   1.C7            R11P.C7          T12P.C7          # serial 3 PAF A1.C7
q                   1.C4            R11P.C4          T12P.C4          # serial 4 PAF A1.C4
q                   1.C3            R11P.C3          T12P.C3          # serial 5 PAF A1.C3
q                   1.C5            R11P.C5          T12P.C5          # serial 6 PAF A1.C5
q                   1.C8            R11P.C8          T12P.C8          # serial 7 PAF A1.C8
q                   1.C1            R11P.C1          T12P.C1          # serial 8 PAF A1.C1
q                   1.C2            R11P.C2          T12P.C2          # serial 9 PAF A1.C2
q                   2.C10           R11E.C10         T12E.C10         # serial 10 ENL B2.C10
q                   2.C11           R11E.C11         T12E.C11         # serial 11 ENL B2.C11
q                   2.C12           R11E.C12         T12E.C12         # serial 12 ENL B2.C12
q                   2.C13           R11E.C13         T12E.C13         # serial 13 ENL B2.C13
q                   2.C14           R11E.C14         T12E.C14         # serial 14 ENL B2.C14
q                   2.C15           R11E.C15         T12E.C15         # serial 15 ENL B2.C15
q                   2.O1            R11E.O1          T12E.O1          # serial 16 ENL B2.O1
q                   4.O3            R11W.O3          T12W.O3          # serial 27 WAT W4.O3
q                   1.H4            R11P.H4          T12P.H4          # serial 28 PAF A1.H4
q                   1.H22           R11P.H22         T12P.H22         # serial 29 PAF A1.H22
q                   1.H11           R11P.H11         T12P.H11         # serial 30 PAF A1.H11
q                   1.H9            R11P.H9          T12P.H9          # serial 31 PAF A1.H9
