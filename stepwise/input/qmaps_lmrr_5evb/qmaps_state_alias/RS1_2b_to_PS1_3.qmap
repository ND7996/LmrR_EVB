# RS1_2b_to_PS1_3
# RS1.2b (step_1_3_RS.pdb)  ->  PS1.3 (step_1_3_PS.pdb)
# Carbinolamine dehydration to iminium; W1 hydronium protonates the OH leaving group and the C-N bond becomes iminium-like.
#
# q atom (q)         PDB ID          LIB ID (resname.name)
# or neighbour (n)?  (resid.atom)    RS1.2b         PS1.3         
#
# STATE-ALIAS MODE: make sure your .lib residue names match these aliases.
# Component aliases:
#   ACE: P12A -> P13A
#   ENL: P12E -> P13E
#   NME: P12N -> P13N
#   PAF: P12P -> P13P
#   WA2: P122 -> P132
#   WAT: P12W -> P13W
#
q                   1.N2            P12P.N2          P13P.N2          # serial 1 PAF A1.N2
q                   1.C9            P12P.C9          P13P.C9          # serial 2 PAF A1.C9
q                   1.C7            P12P.C7          P13P.C7          # serial 3 PAF A1.C7
q                   1.C4            P12P.C4          P13P.C4          # serial 4 PAF A1.C4
q                   1.C3            P12P.C3          P13P.C3          # serial 5 PAF A1.C3
q                   1.C5            P12P.C5          P13P.C5          # serial 6 PAF A1.C5
q                   1.C8            P12P.C8          P13P.C8          # serial 7 PAF A1.C8
q                   1.C1            P12P.C1          P13P.C1          # serial 8 PAF A1.C1
q                   1.C2            P12P.C2          P13P.C2          # serial 9 PAF A1.C2
q                   2.C10           P12E.C10         P13E.C10         # serial 10 ENL B2.C10
q                   2.C11           P12E.C11         P13E.C11         # serial 11 ENL B2.C11
q                   2.C12           P12E.C12         P13E.C12         # serial 12 ENL B2.C12
q                   2.C13           P12E.C13         P13E.C13         # serial 13 ENL B2.C13
q                   2.C14           P12E.C14         P13E.C14         # serial 14 ENL B2.C14
q                   2.C15           P12E.C15         P13E.C15         # serial 15 ENL B2.C15
q                   2.O1            P12E.O1          P13E.O1          # serial 16 ENL B2.O1
q                   4.O3            P12W.O3          P13W.O3          # serial 27 WAT W4.O3
q                   1.H4            P12P.H4          P13P.H4          # serial 28 PAF A1.H4
q                   1.H22           P12P.H22         P13P.H22         # serial 29 PAF A1.H22
q                   1.H11           P12P.H11         P13P.H11         # serial 30 PAF A1.H11
q                   1.H9            P12P.H9          P13P.H9          # serial 31 PAF A1.H9
q                   1.H10           P12P.H10         P13P.H10         # serial 32 PAF A1.H10
q                   1.H12           P12P.H12         P13P.H12         # serial 33 PAF A1.H12
q                   1.H6            P12P.H6          P13P.H6          # serial 34 PAF A1.H6
q                   1.H7            P12P.H7          P13P.H7          # serial 35 PAF A1.H7
q                   1.H8            P12P.H8          P13P.H8          # serial 36 PAF A1.H8
q                   1.H2            P12P.H2          P13P.H2          # serial 37 PAF A1.H2
q                   2.H             P12N.H           P13N.H           # serial 38 NME A2.H
q                   2.H12           P12E.H12         P13E.H12         # serial 39 ENL B2.H12
q                   2.H13           P12E.H13         P13E.H13         # serial 40 ENL B2.H13
q                   2.H14           P12E.H14         P13E.H14         # serial 41 ENL B2.H14
q                   2.H15           P12E.H15         P13E.H15         # serial 42 ENL B2.H15
